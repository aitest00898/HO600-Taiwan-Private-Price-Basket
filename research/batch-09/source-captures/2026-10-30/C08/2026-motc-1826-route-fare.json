  <script type="text/javascript">
  function is_null(obj)  
  {  
     if (typeof(obj) == 'undefined' || obj == null)  
        return true;  
     return false;  
  } 
  
  function searchprice()
  {
     //1、由日期及時段求discount_id
     var day = new Date($("input[id='date1']").val()).getDay();
     var period = $("select[id='ddltime']").val();
     var car = $("select[id='ddlcar']").val().split('_')[0];
     var trc = $("select[id='ddlcar']").val().split('_')[1];
     var tc_id =  'time_' + day + '_' + period + '_' + trc;
     var type_id = $("select[id='ddltype']").val().split('_')[0];
     var multi = $("select[id='ddltype']").val().split('_')[1]; 
     var discount_id;
     var tc = document.getElementById(tc_id);
     
     if(multi == "True" && !(is_null(tc)))
     {
        discount_id = $("td[id=" + tc_id + "]").attr("discount");
     }
     else
     {
        discount_id = $("select[id='ddltype']").val().split('_')[2]; 
     }  
     
     
     //2、求票價
     var stop1 = parseInt($("select[id='ddlStop1']").val());
     var stop2 = parseInt($("select[id='ddlStop2']").val());
     var price_id;
     if(stop1 < stop2)
     {
        price_id = 'tc_' + type_id + '_' + discount_id  + '_' + stop1 + '_' + stop2 + '_' + trc;
        $("input[id='txbPrice']").val($("td[id=" + price_id + "]").text());
     }
     else if (stop1 > stop2)
     {
        price_id = 'tc_' + type_id + '_' + discount_id  + '_' + stop2 + '_' + stop1 + '_' + trc;
        $("input[id='txbPrice']").val($("td[id=" + price_id + "]").text());
     }
     else 
     {
        $("input[id='txbPrice']").val('--');
     }
      
  }
  </script>
